{
  "env": {
    "FAMS_VUE_HOME": "/paperclip/fams-vue-agents",
    "npm_config_include": "dev",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(git credential:*)",
      "Bash(git tag:*)",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Read(//paperclip/fams-vue-agents/secrets/**)",
      "Edit(//paperclip/fams-vue-agents/secrets/**)",
      "Edit(//paperclip/fams-vue-agents/scripts/**)",
      "Edit(//paperclip/fams-vue-agents/config/**)",
      "Edit(//paperclip/fams-vue-agents/agent/**)",
      "Edit(//paperclip/fams-vue-agents/workspace/.claude/**)",
      "Edit(//paperclip/fams-vue-agents/workspace/repos/*/.git/**)",
      "Write(//paperclip/fams-vue-agents/secrets/**)",
      "Write(//paperclip/fams-vue-agents/scripts/**)",
      "Write(//paperclip/fams-vue-agents/config/**)",
      "Write(//paperclip/fams-vue-agents/agent/**)",
      "Write(//paperclip/fams-vue-agents/workspace/.claude/**)",
      "Write(//paperclip/fams-vue-agents/workspace/repos/*/.git/**)",
      "mcp__notion",
      "Task",
      "Agent",
      "WebSearch"
    ]
  }
}
