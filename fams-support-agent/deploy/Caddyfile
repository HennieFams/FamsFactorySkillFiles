# Public HTTPS entry point for the Freshdesk webhook ONLY.
# Everything except the Paperclip routine-trigger "fire" path returns 404, so the
# Paperclip UI/API stays private.
#
# WEBHOOK_HOST = the VM's public DNS name (Azure Portal > VM > Public IP > Configuration > DNS name label),
#   e.g. famsfactory-vm.southafricanorth.cloudapp.azure.com
# Caddy gets/renews the Let's Encrypt certificate itself (needs port 80 reachable for that).

{$WEBHOOK_HOST} {
	@hook {
		method POST
		path_regexp ^/api/routine-triggers/public/[A-Za-z0-9_-]+/fire$
	}
	handle @hook {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:3100 {
			# Paperclip only accepts its own host names; present the request as local
			header_up Host localhost:3100
			# Caddy adds X-Forwarded-Host (the public name) by default; Paperclip checks it
			# against its allowed hostnames and returns 403, so drop it.
			header_up -X-Forwarded-Host
		}
	}
	handle {
		respond 404
	}
	log {
		output file /var/log/caddy/webhook.log
	}
}
