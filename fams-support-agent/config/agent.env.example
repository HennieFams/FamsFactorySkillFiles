# FAMS Support Agent settings + secrets.
# Lives at /paperclip/fams-support-agent/config/agent.env inside the Paperclip container (chmod 600).
# NEVER commit the real file. Create/update it with:  sudo bash deploy/set_config.sh

# --- secrets ---
FRESHDESK_API_KEY=
AZURE_BLOB_CONTAINER_SAS_URL=
SENDGRID_PROXY_BASE=
# Notion internal integration token (read-only, shared with the FAMS Support page)
NOTION_API_KEY=

# --- settings ---
FRESHDESK_DOMAIN=tecmo.freshdesk.com
AZURE_BLOB_PREFIX=ticketingfolder/freshdesk_conversations/tickets_tecmo/
SUPPORT_REVIEWER_EMAIL=schalk@fams.co.za
SUPPORT_EMAIL_ALLOWED_TO=schalk@fams.co.za
# dryrun = write emails to data/outbox only;  fams_proxy = really send via the SendGrid proxy
SUPPORT_EMAIL_MODE=dryrun
# Tickets created before this moment (UTC) are ignored
SUPPORT_AGENT_START_AT=2026-10-01T12:00:00Z
# Notion knowledge base (FAMS Workspace Portal / FAMS Support) - ids are not secret
NOTION_SUPPORT_PAGE_ID=3f075654d68a81f0a67dfe6cb61584f6
NOTION_KB_DATABASE_ID=3001ca67cb0d47a8ba97f2fa27f674e9
NOTION_FIXES_DATABASE_ID=9a71c3749f8041d785b78ab17a464870
